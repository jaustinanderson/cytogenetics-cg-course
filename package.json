{
  "name": "cytogenetics-cg-course",
  "version": "1.1.1",
  "private": true,
  "description": "Validation tooling for the Cytogenetics CG(ASCP) Study Course.",
  "type": "module",
  "scripts": {
    "test": "npm run validate && npm run test:behavior",
    "validate": "node tests/validate-course.mjs",
    "test:behavior": "node tests/dom-behavior.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
