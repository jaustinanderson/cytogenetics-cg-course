{
  "name": "cytogenetics-cg-course",
  "version": "1.1.1",
  "private": true,
  "description": "Validation tooling for the Cytogenetics CG(ASCP) Study Course.",
  "type": "module",
  "scripts": {
    "test": "npm run validate && npm run test:behavior && npm run test:verify-deployed-revision",
    "validate": "node tests/validate-course.mjs",
    "test:behavior": "node tests/dom-behavior.mjs",
    "test:verify-deployed-revision": "node tests/verify-deployed-revision.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:deployed": "playwright test --config=playwright.deployed.config.mjs",
    "verify:deployed-revision": "node scripts/verify-deployed-revision.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1"
  }
}
